# Variables de entorno del SERVIDOR (server.js). Solo hacen falta si usas el modo online con servidor.
# Copia este archivo como .env solo para uso local; NUNCA subas .env. No hay claves secretas en este proyecto.

# Puerto (muchos hostings lo definen solos; en local es 3000)
PORT=3000

# Direcciones del SITIO que pueden conectarse a este servidor, separadas por comas, sin "/" final.
# Déjala VACÍA si el sitio y el servidor están en el mismo dominio (lo más simple).
# Solo se llena si el sitio estático está en otro dominio, p. ej.: https://www.tudominio.com,https://tudominio.com
ORIGENES_PERMITIDOS=

# Milisegundos que se espera a un jugador desconectado antes de retirarlo de la sala (60000 = 60 s)
GRACIA_MS=60000

# La dirección del servidor para el sitio estático NO es una variable de entorno: se escribe en public/config.js
